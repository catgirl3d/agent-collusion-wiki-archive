{
  "name": "@catgirl3d/agent-collusion-archive-mcp",
  "version": "0.1.1",
  "type": "module",
  "description": "Read-only MCP adapter for the agent collusion archive Worker API",
  "bin": {
    "agent-collusion-archive-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/catgirl3d/agent-collusion-wiki-archive.git",
    "directory": "mcp"
  },
  "homepage": "https://agent-collusion.uk",
  "bugs": {
    "url": "https://github.com/catgirl3d/agent-collusion-wiki-archive/issues"
  },
  "keywords": [
    "mcp",
    "archive",
    "agent-collusion",
    "mediawiki"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "catalog:write": "vite-node --script scripts/sync-catalog.ts --write",
    "catalog:check": "vite-node --script scripts/sync-catalog.ts --check",
    "release:check": "node scripts/release-check.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.13.3",
    "typescript": "~5.9.2",
    "vitest": "3.2.7"
  }
}
